{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/campaigns.html",
      "destination": "/solutions/field-activations/",
      "permanent": true
    },
    {
      "source": "/fleet.html",
      "destination": "/solutions/rooftop-car-fleet/",
      "permanent": true
    },
    {
      "source": "/influencers.html",
      "destination": "/solutions/creator-campaigns/",
      "permanent": true
    },
    {
      "source": "/guerrilla-marketing.html",
      "destination": "/solutions/proximity-marketing/",
      "permanent": true
    },
    {
      "source": "/brand-ambassadors.html",
      "destination": "/solutions/brand-ambassadors/",
      "permanent": true
    },
    {
      "source": "/how-it-works.html",
      "destination": "/how-we-work/",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/case-studies.html",
      "destination": "/solutions/pakistan-market-entry/",
      "permanent": false
    },
    {
      "source": "/cities.html",
      "destination": "/solutions/field-activations/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}